+void RenderingDeviceDriverVulkan::_amd_ffx_pick_queues() {
+	AmdFfx::fg_queues_ready = false;
+	if (!AmdFfx::frame_generation_requested() || !AmdFfx::is_amd()) {
+		return;
+	}
+
+	const uint32_t family_count = queue_family_properties.size();
+	LocalVector<uint32_t> next_free;
+	next_free.resize(family_count);
+	for (uint32_t i = 0; i < family_count; i++) {
+		// A fila 0 de cada família é do Godot.
+		next_free[i] = queue_families[i].size();
+	}
+
+	auto flags_of = [&](uint32_t i) { return queue_family_properties[i].queueFlags; };
+	auto can_present = [&](uint32_t i) -> bool {
+		return vkGetPhysicalDeviceWin32PresentationSupportKHR != nullptr && vkGetPhysicalDeviceWin32PresentationSupportKHR(physical_device, i) == VK_TRUE;
+	};
+	auto take = [&](uint32_t i, VkQueueInfoFFXAPI &r_info) -> bool {
+		if (i >= amd_ffx_queue_counts.size() || next_free[i] >= amd_ffx_queue_counts[i]) {
+			return false;
+		}
+		r_info = {};
+		vkGetDeviceQueue(vk_device, i, next_free[i], &r_info.queue);
+		r_info.familyIndex = i;
+		r_info.submitFunc = nullptr;
+		next_free[i]++;
+		return r_info.queue != VK_NULL_HANDLE;
+	};
+
+	bool present_ok = false;
+	for (uint32_t i = 0; i < family_count && !present_ok; i++) {
+		if ((flags_of(i) & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)) == (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT) && can_present(i)) {
+			present_ok = take(i, AmdFfx::q_present);
+		}
+	}
+	for (uint32_t i = 0; i < family_count && !present_ok; i++) {
+		if ((flags_of(i) & (VK_QUEUE_TRANSFER_BIT | VK_QUEUE_COMPUTE_BIT | VK_QUEUE_GRAPHICS_BIT)) && can_present(i)) {
+			present_ok = take(i, AmdFfx::q_present);
+		}
+	}
+
+	bool acquire_ok = false;
+	for (uint32_t i = 0; i < family_count && !acquire_ok; i++) {
+		if (!(flags_of(i) & (VK_QUEUE_COMPUTE_BIT | VK_QUEUE_GRAPHICS_BIT))) {
+			acquire_ok = take(i, AmdFfx::q_acquire);
+		}
+	}
+	for (uint32_t i = 0; i < family_count && !acquire_ok; i++) {
+		if (!(flags_of(i) & VK_QUEUE_GRAPHICS_BIT)) {
+			acquire_ok = take(i, AmdFfx::q_acquire);
+		}
+	}
+	for (uint32_t i = 0; i < family_count && !acquire_ok; i++) {
+		acquire_ok = take(i, AmdFfx::q_acquire);
+	}
+
+	bool async_ok = false;
+	for (uint32_t i = 0; i < family_count && !async_ok; i++) {
+		if ((flags_of(i) & VK_QUEUE_COMPUTE_BIT) && !(flags_of(i) & VK_QUEUE_GRAPHICS_BIT)) {
+			async_ok = take(i, AmdFfx::q_async);
+		}
+	}
+	for (uint32_t i = 0; i < family_count && !async_ok; i++) {
+		if (flags_of(i) & VK_QUEUE_COMPUTE_BIT) {
+			async_ok = take(i, AmdFfx::q_async);
+		}
+	}
+	if (!async_ok) {
+		AmdFfx::q_async = {};
+	}
+
+	AmdFfx::fg_queues_ready = present_ok && acquire_ok;
+	if (!AmdFfx::fg_queues_ready) {
+		AmdFfx::set_status_fg("Gerador de quadros: a placa não tem filas livres suficientes");
+	}
+}
