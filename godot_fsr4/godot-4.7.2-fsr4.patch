+void RenderingDeviceDriverVulkan::_amd_ffx_replace_swap_chain(CommandQueue *p_command_queue, SwapChain *p_swap_chain, const VkSwapchainCreateInfoKHR &p_create_info) {
+	if (!AmdFfx::fg_queues_ready || AmdFfx::swapchain_context != nullptr) {
+		return;
+	}
+
+	ffxCreateContextDescFrameGenerationSwapChainVersionVK version = {};
+	version.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATIONSWAPCHAIN_VERSION_VK;
+	version.version = FFX_FRAMEGENERATION_SWAPCHAIN_VK_VERSION;
+
+	VkSwapchainKHR swapchain = p_swap_chain->vk_swapchain;
+	ffxCreateContextDescFrameGenerationSwapChainVK desc = {};
+	desc.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FGSWAPCHAIN_VK;
+	desc.header.pNext = &version.header;
+	desc.physicalDevice = physical_device;
+	desc.device = vk_device;
+	desc.swapchain = &swapchain;
+	desc.allocator = nullptr;
+	desc.createInfo = p_create_info;
+	desc.gameQueue.queue = queue_families[p_command_queue->queue_family][p_command_queue->queue_index].queue;
+	desc.gameQueue.familyIndex = p_command_queue->queue_family;
+	desc.gameQueue.submitFunc = nullptr;
+	desc.asyncComputeQueue = AmdFfx::q_async;
+	desc.presentQueue = AmdFfx::q_present;
+	desc.imageAcquireQueue = AmdFfx::q_acquire;
+
+	ffxContext context = nullptr;
+	ffxReturnCode_t ret = AmdFfx::fn.CreateContext(&context, &desc.header, nullptr);
+	if (ret != FFX_API_RETURN_OK || context == nullptr) {
+		AmdFfx::set_status_fg("Gerador de quadros: não consegui criar a swapchain (" + AmdFfx::error_name(ret) + ")");
+		AmdFfx::fg_queues_ready = false;
+		// A swapchain original pode ter sido destruída; se sim, recria do jeito normal.
+		if (swapchain == VK_NULL_HANDLE) {
+			device_functions.CreateSwapchainKHR(vk_device, &p_create_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SWAPCHAIN_KHR), &p_swap_chain->vk_swapchain);
+		}
+		return;
+	}
+
+	ffxQueryDescSwapchainReplacementFunctionsVK replacement = {};
+	replacement.header.type = FFX_API_QUERY_DESC_TYPE_FGSWAPCHAIN_FUNCTIONS_VK;
+	ret = AmdFfx::fn.Query(&context, &replacement.header);
+	if (ret != FFX_API_RETURN_OK || replacement.pOutQueuePresentKHR == nullptr) {
+		AmdFfx::set_status_fg("Gerador de quadros: funções da swapchain indisponíveis (" + AmdFfx::error_name(ret) + ")");
+		AmdFfx::fn.DestroyContext(&context, nullptr);
+		AmdFfx::fg_queues_ready = false;
+		device_functions.CreateSwapchainKHR(vk_device, &p_create_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SWAPCHAIN_KHR), &p_swap_chain->vk_swapchain);
+		return;
+	}
+
+	AmdFfx::swapchain_context = context;
+	AmdFfx::replacement = replacement;
+	AmdFfx::fg_swapchain = swapchain;
+	AmdFfx::display_width = p_create_info.imageExtent.width;
+	AmdFfx::display_height = p_create_info.imageExtent.height;
+	AmdFfx::display_format = p_create_info.imageFormat;
+	p_swap_chain->vk_swapchain = swapchain;
+
+	amd_ffx_original_functions = device_functions;
+	device_functions.GetSwapchainImagesKHR = replacement.pOutGetSwapchainImagesKHR;
+	device_functions.AcquireNextImageKHR = replacement.pOutAcquireNextImageKHR;
+	device_functions.QueuePresentKHR = replacement.pOutQueuePresentKHR;
+	AmdFfx::set_status_fg("gerador de quadros pronto");
+}
+
+bool RenderingDeviceDriverVulkan::_amd_ffx_release_swap_chain(SwapChain *p_swap_chain) {
+	if (AmdFfx::swapchain_context == nullptr || p_swap_chain->vk_swapchain != AmdFfx::fg_swapchain) {
+		return false;
+	}
+
+	// Primeiro o gerador de quadros, depois a swapchain dele.
+	AmdFfx::destroy_fg_context();
+
+	ffxDispatchDescFrameGenerationSwapChainWaitForPresentsVK wait = {};
+	wait.header.type = FFX_API_DISPATCH_DESC_TYPE_FGSWAPCHAIN_WAIT_FOR_PRESENTS_VK;
+	AmdFfx::fn.Dispatch(&AmdFfx::swapchain_context, &wait.header);
+
+	AmdFfx::fn.DestroyContext(&AmdFfx::swapchain_context, nullptr);
+	AmdFfx::swapchain_context = nullptr;
+	if (AmdFfx::replacement.pOutDestroySwapchainFFXAPI != nullptr) {
+		AmdFfx::replacement.pOutDestroySwapchainFFXAPI(vk_device, AmdFfx::fg_swapchain, nullptr, nullptr);
+	}
+	AmdFfx::fg_swapchain = VK_NULL_HANDLE;
+	AmdFfx::replacement = {};
+
+	device_functions.GetSwapchainImagesKHR = amd_ffx_original_functions.GetSwapchainImagesKHR;
+	device_functions.AcquireNextImageKHR = amd_ffx_original_functions.AcquireNextImageKHR;
+	device_functions.QueuePresentKHR = amd_ffx_original_functions.QueuePresentKHR;
+	return true;
+}
