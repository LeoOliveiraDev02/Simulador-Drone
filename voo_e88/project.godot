; Simulador de Drone — voo do E88 (drone dobrável)

config_version=5

[application]

config/project_settings_override="user://graficos.cfg"

config/name="Simulador de Drone - Voo do E88"
run/main_scene="res://cenas/voo.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icone.png"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/handheld/orientation=4

[physics]

common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=12
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=4096
anti_aliasing/quality/msaa_3d.mobile=1

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssil/quality=2
environment/screen_space_reflection/roughness_quality=2
environment/sdfgi/probe_ray_count=3
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
mesh_lod/lod_change/threshold_pixels=0.75
